{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "./dist/main",
    "rootDir": "./src/main",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/main/**/*"
  ],
  "exclude": [
    "src/main/_recovery/**",
    "src/main/**/*.bak*",
    "src/main/**/*.wip",
    "src/main/**/*.truncated*"
  ]
}